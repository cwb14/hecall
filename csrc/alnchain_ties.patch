+// three-way partition around the value at k: [low,lt) smaller, [lt,*eqhi] equal, (*eqhi,high] larger;
+// returns lt. Ties stay in the middle block, so many equal positions cannot make quickSelect quadratic
+static int partition(TNODE *nodes, int *order, int low, int high, int k, int (*position)(TNODE *),
+                     int *eqhi)
+{ int i, lt, gt, p, v;
+  p  = position(nodes + order[k]);
+  lt = low;
+  gt = high;
+  i  = low;
+  while (i <= gt)
+    { v = position(nodes + order[i]);
+      if (v < p)
+        swap(&order[lt++], &order[i++]);
+      else if (v > p)
+        swap(&order[i], &order[gt--]);
+      else
+        i++;
     }
-  swap(&order[i], &order[high]);
-  return (i);
+  *eqhi = gt;
+  return (lt);
 }
 
